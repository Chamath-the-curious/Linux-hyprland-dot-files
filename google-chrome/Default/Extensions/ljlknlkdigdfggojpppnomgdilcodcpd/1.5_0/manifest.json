{
   "action": {
      "default_popup": "popup.html",
      "default_title": "YouTube Play Next Button"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "*://*.youtube.com/*" ],
      "run_at": "document_end"
   } ],
   "description": "Makes YouTube's hidden 'Next' button visible on single videos",
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "YouTube Play Next Button",
   "permissions": [  ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.5"
}
